<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light Mode - Biru Langit). -->
    <style name="Base.Theme.Kalkulator" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_graphite</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Status bar and navigation bar styling -->
        <item name="android:statusBarColor">@color/bg_graphite</item>
        <item name="android:navigationBarColor">@color/bg_graphite</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Kalkulator" parent="Base.Theme.Kalkulator" />
</resources>
