<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalqKeypadButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">@color/accent_orange_light</item>
    </style>

    <style name="CalqNumberButton" parent="CalqKeypadButton">
        <item name="backgroundTint">@color/surface_button_number</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalqFunctionButton" parent="CalqKeypadButton">
        <item name="backgroundTint">@color/surface_button_function</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalqOperatorButton" parent="CalqKeypadButton">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="android:textColor">@color/accent_orange</item>
        <item name="android:textSize">26sp</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CalqEqualsButton" parent="CalqKeypadButton">
        <item name="backgroundTint">@color/accent_orange</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="CalqToolbarIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
