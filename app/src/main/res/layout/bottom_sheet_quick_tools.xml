<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/divider_color" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/title_quick_tools"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPercentage"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tool_percentage"
            android:textColor="@color/text_primary"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/surface_dark"
            app:chipCornerRadius="12dp"
            app:chipStrokeColor="@color/accent_orange"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDiscount"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tool_discount"
            android:textColor="@color/text_primary"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/surface_dark"
            app:chipCornerRadius="12dp"
            app:chipStrokeColor="@color/divider_color"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTemperature"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tool_temperature"
            android:textColor="@color/text_primary"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/surface_dark"
            app:chipCornerRadius="12dp"
            app:chipStrokeColor="@color/divider_color"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.chip.ChipGroup>

    <include
        layout="@layout/view_quick_tools_inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- Result Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvToolSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:text="0"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvToolResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:text="0"
            android:textColor="@color/accent_orange"
            android:textSize="28sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToolUseInCalc"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/use_in_calculator"
        android:textAllCaps="false"
        android:textColor="@color/bg_graphite"
        android:textSize="15sp"
        app:backgroundTint="@color/accent_orange"
        app:cornerRadius="16dp" />

</LinearLayout>
